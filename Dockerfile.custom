# Multi-arch mautrix-teams container image built from the pinned release source.
FROM golang:1-bookworm AS build

RUN apt-get update && \
    apt-get install -y --no-install-recommends git libolm-dev ca-certificates && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .

RUN CGO_ENABLED=1 go build -trimpath -ldflags="-s -w" \
      -o /out/mautrix-teams ./cmd/mautrix-teams

FROM debian:bookworm-slim

LABEL org.opencontainers.image.source="https://github.com/BierDav/mautrix-teams"
LABEL org.opencontainers.image.description="Multi-arch container image for YourSandwich/mautrix-teams"

ENV UID=1337 \
    GID=1337 \
    BRIDGEV2=1

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      ffmpeg libolm3 gosu ca-certificates && \
    rm -rf /var/lib/apt/lists/* && \
    ln -s /usr/sbin/gosu /usr/bin/su-exec

COPY --from=build /out/mautrix-teams /usr/bin/mautrix-teams
COPY docker-run.sh /docker-run.sh
RUN chmod +x /docker-run.sh

VOLUME /data
WORKDIR /data

CMD ["/docker-run.sh"]
